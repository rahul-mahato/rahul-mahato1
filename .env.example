# MemoryOS environment variables
# Copy to .env and fill in. Local-first by default — most envs are optional.

# Telemetry (privacy-respecting; opt-in only)
EXPO_PUBLIC_TELEMETRY_ENABLED=false

# Optional: remote E2EE sync relay (CRDT). Empty = disabled.
EXPO_PUBLIC_SYNC_RELAY_URL=

# Model registry. Defaults bundle on-device; override only for development.
EXPO_PUBLIC_EMBEDDING_MODEL=Xenova/all-MiniLM-L6-v2
EXPO_PUBLIC_LLM_MODEL=Xenova/Phi-3.5-mini-instruct-onnx
EXPO_PUBLIC_WHISPER_MODEL=Xenova/whisper-tiny
